{
  "name": "app-share-music-backend",
  "version": "1.0.0",
  "description": "Api for sharing music",
  "main": "dist/server.js",
  "scripts": {
    "clear-logs": "node scripts/clear-logs.js",
    "predev": "npx tsc --noEmit && npm run clear-logs",
    "dev": "npx ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/server.ts",
    "watch": "nodemon --watch 'src/**/*.ts' --exec 'ts-node -r tsconfig-paths/register' src/server.ts",
    "build": "ttsc",
    "start": "node dist/server.ts",
    "test": "jest",
    "seed": "ts-node -r tsconfig-paths/register scripts/seed.ts",
    "seed:clear": "ts-node -r tsconfig-paths/register scripts/seed.ts clear"
  },
  "keywords": [
    "app-share-music-backend",
    "typescript",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "multer": "^2.0.2",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.10.5",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "ttypescript": "^1.5.15",
    "typescript": "^5.3.3",
    "typescript-transform-paths": "^3.5.5"
  }
}
